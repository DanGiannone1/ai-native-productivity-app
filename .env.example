# =============================================================================
# AI Productivity MCP Server - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env to git (it's in .gitignore)
#
# ENVIRONMENT-SPECIFIC FILES (Recommended):
#   .env.dev  → Development settings (local DBs, dev APIs)
#   .env.prod → Production settings (read-only access, prod endpoints)
#
# The run_local.ps1 script will automatically load .env.{ENVIRONMENT} based
# on the ENVIRONMENT variable (defaults to "dev"). Falls back to .env if not found.

# =============================================================================
# Environment (determines which .env file to load)
# =============================================================================
ENVIRONMENT=dev

# =============================================================================
# Azure Resource Groups
# =============================================================================
# Shared resources (ACR) - logically shared across environments
RESOURCE_GROUP_SHARED=ai-productivity-shared

# Environment-specific resource groups
RESOURCE_GROUP_DEV=ai-productivity-dev
RESOURCE_GROUP_PROD=ai-productivity-prod

# Azure region
AZURE_LOCATION=westus2

# =============================================================================
# Cosmos DB Configuration
# =============================================================================
COSMOS_HOST=https://your-cosmos-account.documents.azure.com:443/
COSMOS_KEY=your-cosmos-primary-key-here
COSMOS_DATABASE=productivity
COSMOS_CONTAINER=productivity-data

# =============================================================================
# Authentication & Authorization
# =============================================================================
# Dev Mode: Bypass authentication (for local development)
DISABLE_AUTH=true
DEFAULT_USER_ID=dev-user

# OAuth 2.1 (Future - Not used in MVP)
# OAUTH_ENVIRONMENT_URL=https://your-oauth-provider.com
# OAUTH_CLIENT_ID=your-client-id
# OAUTH_CLIENT_SECRET=your-client-secret
# MCP_URL=https://your-mcp-server.azurecontainerapps.io/

# =============================================================================
# Observability & Monitoring
# =============================================================================
# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# LangSmith AI Tracing (Optional, for AI observability)
# LANGSMITH_API_KEY=lsv2_your-langsmith-api-key-here
# LANGSMITH_PROJECT=productivity-mcp
# LANGSMITH_TRACING=true

# Application Insights (Optional, for Azure monitoring)
# APPINSIGHTS_CONNECTION_STRING=InstrumentationKey=your-key-here

# =============================================================================
# AI Provider APIs (Optional - for future AI features)
# =============================================================================
# Claude API (Anthropic)
# CLAUDE_API_KEY=sk-ant-api03-your-claude-api-key-here

# OpenAI API
# OPENAI_API_KEY=sk-your-openai-api-key-here

# =============================================================================
# Container Apps (For deployment)
# =============================================================================
# Container Apps Environment
# CONTAINER_APP_ENV=ai-prod-env

# Azure Container Registry
# ACR_NAME=your-acr-name
# ACR_SERVER=your-acr-name.azurecr.io

# MCP App Name
# MCP_APP_NAME=ai-prod-mcp

# =============================================================================
# Performance & Rate Limiting
# =============================================================================
# MCP Server Configuration
# MAX_CONCURRENT_REQUESTS=10
# REQUEST_TIMEOUT_SECONDS=30

# Cosmos DB Performance
# COSMOS_MAX_RETRY_ATTEMPTS=3
# COSMOS_RETRY_DELAY_MS=1000

# =============================================================================
# Development Tools
# =============================================================================
# Enable debug mode (verbose logging, detailed errors)
# DEBUG=false

# Enable request/response logging for MCP tools
# LOG_MCP_REQUESTS=false

# Enable SQL query logging for Cosmos DB
# LOG_COSMOS_QUERIES=false
