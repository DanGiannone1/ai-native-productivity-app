# =============================================================================
# Productivity MCP Server - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env to git (it's in .gitignore)
#
# ENVIRONMENT-SPECIFIC FILES (Recommended):
#   .env.dev  → Development settings (local DBs, dev APIs)
#   .env.prod → Production settings (read-only access, prod endpoints)
#
# The run_local.ps1 script will automatically load .env.{ENVIRONMENT} based
# on the ENVIRONMENT variable (defaults to "dev"). Falls back to .env if not found.
#
# Usage:
#   1. Create .env.dev with your development configuration
#   2. Optionally create .env.prod with production read-only configuration
#   3. Run scripts normally - they will load the correct file automatically

# =============================================================================
# Environment (determines which .env file to load)
# =============================================================================
# Set to "dev" or "prod" to load .env.dev or .env.prod respectively
# Default: dev
ENVIRONMENT=dev

# =============================================================================
# Azure Resource Groups (3-RG Silo Pattern)
# =============================================================================
# Shared resources (ACR, ACS) - high fixed-cost, logically shared
RESOURCE_GROUP_SHARED=soligence-shared-services

# Environment-specific resource groups
RESOURCE_GROUP_DEV=prism-dev
RESOURCE_GROUP_PROD=prism-prod

# Azure region
AZURE_LOCATION=westus2

# =============================================================================
# Cosmos DB Configuration
# =============================================================================
COSMOS_HOST=https://your-cosmos-account.documents.azure.com:443/
COSMOS_KEY=your-cosmos-primary-key-here
COSMOS_DATABASE=productivity
COSMOS_CONTAINER=productivity-data

# Cosmos DB Account Names (for infrastructure scripts)
COSMOS_ACCOUNT_DEV=cosmos-prism-dev
COSMOS_ACCOUNT_PROD=cosmos-prism-prod

# =============================================================================
# Authentication & Authorization
# =============================================================================
# Dev Mode: Bypass authentication (for local development)
DISABLE_AUTH=true
DEFAULT_USER_ID=dev-user

# Scalekit OAuth 2.1 (Phase 2 - Not used in MVP, disabled)
# Uncomment and configure when ready to enable OAuth
# SCALEKIT_ENVIRONMENT_URL=https://your-org.scalekit.dev
# SCALEKIT_CLIENT_ID=skc_your-client-id
# SCALEKIT_CLIENT_SECRET=your-client-secret
# SCALEKIT_RESOURCE_ID=res_your-resource-id
# MCP_URL=https://your-mcp-server.azurecontainerapps.io/

# M2M (Machine-to-Machine) Clients Whitelist
# Comma-separated list of authorized Scalekit client IDs for M2M auth
# AUTHORIZED_M2M_CLIENTS=skc_client1,skc_client2

# =============================================================================
# Observability & Monitoring
# =============================================================================
# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# LangSmith AI Tracing (Phase 3 - Optional, for AI observability)
# Uncomment to enable LangSmith tracing for debugging AI interactions
# LANGSMITH_API_KEY=lsv2_your-langsmith-api-key-here
# LANGSMITH_PROJECT=productivity-mcp
# LANGSMITH_TRACING=true  # Set to false to disable

# Application Insights (Phase 3 - Optional, for Azure monitoring)
# APPINSIGHTS_CONNECTION_STRING=InstrumentationKey=your-key-here

# =============================================================================
# AI Provider APIs (Optional - for future AI features)
# =============================================================================
# Claude API (Anthropic) - For direct Claude API calls
# CLAUDE_API_KEY=sk-ant-api03-your-claude-api-key-here

# OpenAI API - For embeddings, fallback models, or token counting
# OPENAI_API_KEY=sk-your-openai-api-key-here

# =============================================================================
# Azure Communication Services (Phase 2+ - For email notifications)
# =============================================================================
# ACS_CONNECTION_STRING=endpoint=https://acs-prism-shared.communication.azure.com/;accesskey=your-key
# ACS_SENDER_EMAIL=noreply@your-domain.com

# =============================================================================
# Container Apps (Phase 2 - For deployment)
# =============================================================================
# Container Apps Environment Names
# CONTAINER_ENV_DEV=prism-env-dev
# CONTAINER_ENV_PROD=prism-env-prod

# Azure Container Registry
# ACR_NAME=acrprismshr
# ACR_LOGIN_SERVER=acrprismshr.azurecr.io

# =============================================================================
# Database Migration & Seeding
# =============================================================================
# Set to true to enable automatic schema migration on startup
# AUTO_MIGRATE=false

# Set to true to seed sample data on first run
# SEED_SAMPLE_DATA=false

# =============================================================================
# Performance & Rate Limiting
# =============================================================================
# MCP Server Configuration
# MAX_CONCURRENT_REQUESTS=10
# REQUEST_TIMEOUT_SECONDS=30

# Cosmos DB Performance
# COSMOS_MAX_RETRY_ATTEMPTS=3
# COSMOS_RETRY_DELAY_MS=1000

# =============================================================================
# Feature Flags (Phase 2+)
# =============================================================================
# Enable/disable features for gradual rollout
# FEATURE_ADVANCED_SEARCH=false
# FEATURE_AI_SUGGESTIONS=false
# FEATURE_BULK_OPERATIONS=false

# =============================================================================
# Development Tools
# =============================================================================
# Enable debug mode (verbose logging, detailed errors)
# DEBUG=false

# Enable request/response logging for MCP tools
# LOG_MCP_REQUESTS=false

# Enable SQL query logging for Cosmos DB
# LOG_COSMOS_QUERIES=false
