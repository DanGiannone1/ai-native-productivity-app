# AI Productivity MCP Server - Production Environment
# Copy this file to .env.prod and fill in your values

# ============================================================================
# Resource Group for Prod
# ============================================================================
RESOURCE_GROUP=ai-productivity-prod

# ============================================================================
# Cosmos DB (Prod)
# ============================================================================
# Get these from Azure Portal > Cosmos DB > Keys
COSMOS_HOST=https://your-cosmos-prod.documents.azure.com:443/
COSMOS_KEY=your-prod-cosmos-key

# ============================================================================
# Application Settings (Prod)
# ============================================================================
ENVIRONMENT=prod
DISABLE_AUTH=true
DEFAULT_USER_ID=demo-user
LOG_LEVEL=INFO

# NOTE: For production with authentication, set:
# DISABLE_AUTH=false
# And configure your preferred auth provider
