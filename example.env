# AI Productivity MCP Server - Shared Environment Variables
# Copy this file to .env and fill in your values
# Environment-specific values go in .env.dev or .env.prod

# ============================================================================
# Azure Resources (Shared across environments)
# ============================================================================

# Azure Container Registry (shared for all environments)
ACR_NAME=your-acr-name
ACR_SERVER=your-acr-name.azurecr.io
RESOURCE_GROUP_SHARED=ai-productivity-shared

# Container App Environment base name (will be suffixed with -dev or -prod)
CONTAINER_APP_ENV=ai-prod-env

# MCP App base name (will be suffixed with -dev or -prod)
MCP_APP_NAME=ai-prod-mcp

# Image prefix for Docker images
IMAGE_PREFIX=ai-productivity

# ============================================================================
# Cosmos DB Configuration (Shared settings)
# ============================================================================

# Database and container names (same for dev and prod)
COSMOS_DATABASE=productivity
COSMOS_CONTAINER=productivity-data

# ============================================================================
# Optional: AI/Observability
# ============================================================================

# LangSmith (optional - for AI tracing)
# LANGSMITH_API_KEY=your-langsmith-key
# LANGSMITH_TRACING=true
